# EduInsight Configuration
# Copy this file to .env and fill in values as needed.
# All variables are prefixed with EDUINSIGHT_ (case-insensitive).

# ============================================================
# Core / Memory
# ============================================================

# Lite-Mem storage path (default: eduinsight.db)
EDUINSIGHT_MEMORY_DB_PATH=./eduinsight_demo.db

# Memory search settings (defaults are sane)
# EDUINSIGHT_MEMORY_TOP_K=8
# EDUINSIGHT_MEMORY_EMBEDDER=auto  # auto|stub|gemini

# ============================================================
# LLM provider — set ONE for AI-powered chat
# ============================================================
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
# GROQ_API_KEY=your_groq_api_key
# (or fall back to `claude` CLI if installed)

# ============================================================
# Server
# ============================================================
# Local defaults. For deployment set production; Docker defaults to production,
# but this env file overrides it if passed to --env-file.
EDUINSIGHT_ENV=development
# Demo accounts/features are available ONLY in development.
# Set false to disable them in development; true never enables them in production.
# EDUINSIGHT_DEMO_MODE=false
EDUINSIGHT_ENABLE_LTI_BRIDGE=false
# Keep enabled in production; disable only in isolated tests.
EDUINSIGHT_LOGIN_THROTTLE_ENABLED=true
# EDUINSIGHT_HOST=127.0.0.1
# EDUINSIGHT_PORT=8000

# ============================================================
# CORS — origins that can call this API from a browser.
# Comma-separated. Set this to your Next.js frontend URL.
# ============================================================
EDUINSIGHT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# Auth — Version A (standalone) or Version B (Moodle LTI)
# ============================================================

# Auth mode: jwt | lti | both
# - jwt   : standalone, /auth/login + /auth/register
# - lti   : Moodle launches drive auth via /lti/launch
# - both  : both endpoints active (recommended for dev)
EDUINSIGHT_AUTH_MODE=both

# JWT secret — generate via: python -c "import secrets; print(secrets.token_hex(32))"
EDUINSIGHT_JWT_SECRET=dev-only-secret-change-me-in-production
EDUINSIGHT_JWT_EXPIRE_MINUTES=10080

# Auth DB (separate from Lite-Mem memory DB)
EDUINSIGHT_AUTH_DB_PATH=./eduinsight_auth.db

# Frontend URL — LTI redirects with a 60-second single-use code, never a JWT.
# A future LTI frontend must POST {"code": "..."} to /lti/exchange and remove
# the code from browser history. The current frontend does not use LTI.
EDUINSIGHT_FRONTEND_URL=http://localhost:3000

# ============================================================
# Moodle (only Version B needs these)
# ============================================================
# EDUINSIGHT_MOODLE_URL=https://moodle.ntust.edu.tw
# EDUINSIGHT_MOODLE_TOKEN=your_moodle_web_service_token

# Production checklist:
# - EDUINSIGHT_ENV=production, EDUINSIGHT_DEMO_MODE=false, bridge=false, throttle=true.
# - Generate a random JWT secret >=32 characters; the dev secret/placeholders fail startup.
# - Start with a clean persistent auth DB; do not copy demo accounts into production.
# - Provision the initial admin through trusted backend code (see DEPLOY.md).
# - allow_self_register is a DB platform setting: false by default for new production
#   databases, editable only through /admin/settings; existing explicit settings persist.
# - Public registration accepts only username/password/display_name and creates students.
# - Registration/provisioning/reset passwords: 8..72 UTF-8 bytes (4..72 in development).
# - Use HTTPS and exact CORS origins; use one worker for process-local login/LTI stores.

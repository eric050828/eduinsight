# EduInsight Configuration
# Copy this file to .env and fill in values as needed.
# All variables are prefixed with EDUINSIGHT_ (case-insensitive).

# Moodle connection (optional — only needed for real Moodle integration)
# EDUINSIGHT_MOODLE_URL=https://moodle.ntust.edu.tw
# EDUINSIGHT_MOODLE_TOKEN=your_moodle_web_service_token

# Lite-Mem storage path (default: eduinsight.db in working directory)
EDUINSIGHT_MEMORY_DB_PATH=./eduinsight_demo.db

# Memory search settings
# EDUINSIGHT_MEMORY_TOP_K=8
# EDUINSIGHT_MEMORY_EMBEDDER=auto  # auto|stub|gemini

# LLM provider (set ONE of these for AI-powered chat)
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
# GROQ_API_KEY=your_groq_api_key

# Server
# EDUINSIGHT_HOST=127.0.0.1
# EDUINSIGHT_PORT=8000

# EduInsight Configuration
# Copy this file to .env and fill in values as needed.
# All variables are prefixed with EDUINSIGHT_ (case-insensitive).

# ============================================================
# Core / Memory
# ============================================================

# Lite-Mem storage path (default: eduinsight.db)
EDUINSIGHT_MEMORY_DB_PATH=./eduinsight_demo.db

# Memory search settings (defaults are sane)
# EDUINSIGHT_MEMORY_TOP_K=8
# EDUINSIGHT_MEMORY_EMBEDDER=auto  # auto|stub|gemini

# ============================================================
# LLM provider — set ONE for AI-powered chat
# ============================================================
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
# GROQ_API_KEY=your_groq_api_key
# (or fall back to `claude` CLI if installed)

# ============================================================
# Server
# ============================================================
# EDUINSIGHT_HOST=127.0.0.1
# EDUINSIGHT_PORT=8000

# ============================================================
# CORS — origins that can call this API from a browser.
# Comma-separated. Set this to your Next.js frontend URL.
# ============================================================
EDUINSIGHT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# Auth — Version A (standalone) or Version B (Moodle LTI)
# ============================================================

# Auth mode: jwt | lti | both
# - jwt   : standalone, /auth/login + /auth/register
# - lti   : Moodle launches drive auth via /lti/launch
# - both  : both endpoints active (recommended for dev)
EDUINSIGHT_AUTH_MODE=both

# JWT secret — generate via: python -c "import secrets; print(secrets.token_hex(32))"
EDUINSIGHT_JWT_SECRET=dev-only-secret-change-me-in-production
EDUINSIGHT_JWT_EXPIRE_MINUTES=10080

# Auth DB (separate from Lite-Mem memory DB)
EDUINSIGHT_AUTH_DB_PATH=./eduinsight_auth.db

# Frontend URL — where /lti/launch redirects after issuing JWT
EDUINSIGHT_FRONTEND_URL=http://localhost:3000

# ============================================================
# Moodle (only Version B needs these)
# ============================================================
# EDUINSIGHT_MOODLE_URL=https://moodle.ntust.edu.tw
# EDUINSIGHT_MOODLE_TOKEN=your_moodle_web_service_token
